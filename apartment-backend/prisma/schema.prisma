generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Apartment {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  address     String
  city        String
  price       Decimal  @db.Decimal(10, 2)
  bedrooms    Int
  bathrooms   Int
  area        Int
  images      String[] @default([])
  isVerified  Boolean?
  contactPhone String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}